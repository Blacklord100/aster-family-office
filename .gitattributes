# Keep PDF fixtures byte-identical across checkouts and source packages.
*.pdf binary
# Preserve frozen RFC email bytes and treat CRLF as intentional line endings.
benchmark/**/fixtures/*.eml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Multipart mailroom originals include binary attachment payloads and fixed CRLF.
benchmark/mailroom-v1/fixtures/emails/*.eml binary
# Authentication evidence is hash-pinned to publisher bytes, including CRLF and
# whitespace in public-key armor headers; never normalize those source files.
processor/runtime/source-provenance/* -text
processor/runtime/source-provenance/*.asc whitespace=-blank-at-eol
# Blank patch-context lines contain an intentional leading space in publisher bytes.
processor/runtime/source-provenance/*.patch whitespace=-blank-at-eol
# Native recipe/source evidence retains exact upstream bytes and patch context.
licenses/native/sharp-libvips-1.3.3/** -text
licenses/native/sharp-libvips-1.3.3/metadata/*.patch whitespace=-blank-at-eol
