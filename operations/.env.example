# Configuration only; never put secrets here. Pin reviewed immutable image digests.
ASTER_IMAGE=aster-web:local
PROCESSOR_IMAGE=aster-processor:local
NODE_IMAGE=node:24-bookworm-slim
POSTGRES_IMAGE=postgres:17-bookworm
CADDY_IMAGE=caddy:2-alpine
OLLAMA_IMAGE=ollama/ollama:REPLACE_WITH_REVIEWED_VERSION_OR_DIGEST
ASTER_DOMAIN=aster.example.com
BETTER_AUTH_URL=https://aster.example.com
ACME_EMAIL=ops@example.com
ASTER_LOCAL_PORT=3000
ASTER_SECRETS_DIR=./secrets
# Paths must exist. Import is manual; no model is fetched by this stack.
OLLAMA_MODELS_DIR=./local-models
OLLAMA_IMPORT_DIR=./model-import
OLLAMA_MODEL=aster-approved:gguf
OLLAMA_MEMORY=8g
OCR_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=120
# Agentic total structured calls, including extraction; valid range 1-24.
MAX_AGENT_STEPS=16
POSTGRES_MEMORY=2g
WEB_MEMORY=1g
WORKER_MEMORY=1g
PROCESSOR_MEMORY=2g
# Existing installations: add an encryption_keyring secret containing {} before upgrading.
ENCRYPTION_ACTIVE_KEY_ID=legacy
# Also start --profile delivery and populate smtp_settings to enable recovery delivery.
EMAIL_DELIVERY_ENABLED=false
