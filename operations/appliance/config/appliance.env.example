# Example only. asterctl generates a private environment for an actual install.
# No secret values belong in this file. All image references come from release.json.
ASTER_PROJECT_NAME=aster
ASTER_DATA_ROOT=/var/lib/aster
ASTER_RELEASE_ROOT=/opt/aster/releases/RELEASE_ID
ASTER_RELEASE_ID=RELEASE_ID
ASTER_SCHEMA_MIN=16
ASTER_SCHEMA_MAX=16
ASTER_WRITER_GENERATION=1
ASTER_DOMAIN=aster.office.example
BETTER_AUTH_URL=https://aster.office.example
ASTER_TLS_MODE=internal
# Selected and prepared by asterctl (UID10001, mode0700); not backup data.
# Host systemd sockets accept80/443; Caddy has no Docker port publications.
ASTER_INGRESS_ROOT=/var/lib/aster/run/ingress-sockets
ASTER_IMAGE=aster-web:RELEASE_ID
PROCESSOR_IMAGE=aster-processor:RELEASE_ID
POSTGRES_IMAGE=aster-postgres:RELEASE_ID
OLLAMA_IMAGE=aster-ollama:RELEASE_ID
CADDY_IMAGE=aster-caddy:RELEASE_ID
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_MEMORY=12g
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_TIMEOUT_SECONDS=300
# Connected profile only; collectors also require explicit Compose profiles.
EMAIL_DELIVERY_ENABLED=false
