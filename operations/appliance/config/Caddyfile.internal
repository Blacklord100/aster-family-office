{
	http_port 8080
	https_port 8443
	admin 127.0.0.1:2019
	# Never contact public certificate authorities or install trust on the host.
	auto_https disable_redirects
	skip_install_trust
}
https://{$ASTER_DOMAIN} {
	tls internal
	import /etc/aster/headers.caddy
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
	}
}
http://{$ASTER_DOMAIN} {
	redir {$ASTER_ORIGIN}{uri} permanent
}
