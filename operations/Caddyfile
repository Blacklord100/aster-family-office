{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	admin 127.0.0.1:2019
}
{$ASTER_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	request_body {
		max_size 25MB
	}
	reverse_proxy web:3000 {
		# Replace user-controlled client-IP metadata. App trusts only x-real-ip.
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
	}
	# Access logging omitted: document paths/query strings may be sensitive.
}
