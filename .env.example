# Copy only for manual setup. The local database helper generates private .env.local.
DATABASE_URL=postgresql://aster_runtime:REPLACE@127.0.0.1:55439/aster
MIGRATION_DATABASE_URL=postgresql://aster_migrator:REPLACE@127.0.0.1:55439/aster
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=TODO
ENCRYPTION_KEY=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
PROCESSOR_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
PROCESSOR_URL=http://127.0.0.1:8000
# Cloud stays disabled unless an operator separately provisions a cloud-capable processor.
ALLOW_CLOUD_ENGINES=false
# PROCESSOR_CLOUD_URL=https://private-cloud-processor.example.invalid
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120
OCR_ENABLED=true
# Planner actions (1-64); separate shared structured-call limit (1-96).
MAX_AGENT_STEPS=32
MAX_MODEL_CALLS=64
MAX_PAGE_EXTRACTIONS=2
VISUAL_PAGES_ENABLED=true
MAX_VISUAL_PAGES=6
MAX_VISUAL_BYTES=8388608
MAX_NESTED_EML_DEPTH=3
MAX_EMAIL_PARTS=32
MAX_EMAIL_ATTACHMENTS=8
DOCUMENT_DECODE_TIMEOUT_SECONDS=75
AUTH_REQUIRE_MFA=true
ASTER_ALLOW_SAMPLE_DATA=false

# Optional reviewed encryption rotation. Keep the legacy key for old records/audit.
# ENCRYPTION_KEYRING={"release2":"BASE64_32_BYTE_KEY"}
# ENCRYPTION_ACTIVE_KEY_ID=release2
# Password-reset delivery is opt-in. No delivery worker starts by default.
EMAIL_DELIVERY_ENABLED=false
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=office@example.invalid

# Optional read-only mailbox OAuth. Leave unset until provider apps are registered.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
