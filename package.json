{
  "name": "aster-family-office",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack && npm run build:services",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "oxlint app components/aster components/auth lib data scripts next.config.ts proxy.ts vitest.config.ts",
    "format": "oxfmt",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:services": "node scripts/build-services.mjs",
    "worker": "node dist-worker/index.js",
    "worker:dev": "node --conditions=react-server --import tsx --env-file=.env.local scripts/worker.ts",
    "db:migrate": "node dist-ops/migrate.js",
    "db:migrate:dev": "tsx --env-file=.env.local scripts/migrate.ts",
    "bootstrap": "node dist-ops/bootstrap.js",
    "bootstrap:dev": "tsx --env-file=.env.local scripts/bootstrap.ts",
    "db:local": "node scripts/local-db.mjs",
    "processor:dev": "node --env-file=.env.local scripts/processor-dev.mjs",
    "mailbox:worker": "node dist-mailbox-worker/index.js",
    "mailbox:dev": "node --conditions=react-server --import tsx --env-file=.env.local scripts/mailbox-worker.ts",
    "folder:worker": "node dist-folder-worker/index.js",
    "folder:dev": "node --conditions=react-server --import tsx --env-file=.env.local scripts/folder-worker.ts",
    "demo:status": "node dist-ops/demo-status.js",
    "demo:status:dev": "node --conditions=react-server --import tsx --env-file=.env.local scripts/demo-status.ts",
    "delivery:worker": "node dist-delivery-worker/index.js",
    "delivery:dev": "node --conditions=react-server --import tsx --env-file=.env.local scripts/delivery-worker.ts",
    "reports:worker": "node dist-report-obligations-worker/index.js",
    "reports:dev": "node --conditions=react-server --import tsx --env-file=.env.local scripts/report-obligations-worker.ts",
    "keys:dry-run": "node dist-ops/rotate-keys.js --dry-run",
    "keys:rotate": "node dist-ops/rotate-keys.js --apply",
    "monitor": "node dist-ops/monitor.js",
    "predev": "node scripts/prepare-pdf-worker.mjs",
    "prebuild": "node scripts/prepare-pdf-worker.mjs",
    "archive:worker": "node dist-archive-worker/index.js",
    "archive:dev": "node --conditions=react-server --import tsx --env-file=.env.local scripts/archive-worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@shadcn/react": "0.3.0",
    "better-auth": "1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.5.2",
    "html-to-text": "10.0.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.16.3",
    "postal-mime": "3.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/html-to-text": "9.0.4",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "type": "module",
  "license": "Apache-2.0"
}
